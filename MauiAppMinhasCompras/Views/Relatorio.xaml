<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.Relatorio"
             Title="Relatório por Categoria">
    <StackLayout Padding="15" Spacing="12">
        
        <Label Text="Total gasto por categoria"
               FontSize="18" FontAttributes="Bold"
               HorizontalOptions="Center"/>
        
        <Frame Padding="0" VerticalOptions="FillAndExpand">
            <ListView x:Name="lst_relatorio">
                
                <ListView.Header>
                    <Grid ColumnDefinitions="*,*,Auto"
                          BackgroundColor="{StaticResource Gray100}" Padding="5">
                        <Label Grid.Column="0" Text="Categoria" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="Total Gasto" FontAttributes="Bold"/>
                        <Label Grid.Column="2" Text="Itens" FontAttributes="Bold"/>
                    </Grid>
                </ListView.Header>
               
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid ColumnDefinitions="*,*,Auto" Padding="5">
                                <Label Grid.Column="0"
                                       Text="{Binding Categoria}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                                       Text="{Binding Total, StringFormat='\{\}\{0:C\}'}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="2"
                                       Text="{Binding Quantidade}"
                                       VerticalTextAlignment="Center"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>
       
        <Frame BackgroundColor="{StaticResource Gray100}" Padding="10">
            <Label x:Name="lbl_total_geral"
                   FontSize="16" FontAttributes="Bold"
                   HorizontalOptions="Center"/>
        </Frame>
    </StackLayout>
</ContentPage>